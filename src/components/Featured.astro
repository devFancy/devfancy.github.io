---
import { blankLight } from '../lib/blank';

interface Item {
  slug: string;
  title: string;
  date: Date;
  categories: string[];
  cover?: string;
}
interface Props {
  title: string;
  note: string;
  items: Item[];
}
const { title, note, items } = Astro.props;
const ARROW = { prev: 'M15 5 8 12l7 7', next: 'm9 5 7 7-7 7' };
---
{items.length > 0 && (
  <section class="fx" aria-roledescription="carousel" aria-label={title}>
    <div class="fx-head">
      <h2 class="sec-head text-2xl">
        <span class="font-semibold">{title}</span><span class="sec-note">{note}</span>
      </h2>
      {items.length > 1 && (
        <div class="fx-nav">
          <span class="fx-count" aria-hidden="true"><b data-fx-at>1</b> / {items.length}</span>
          {(['prev', 'next'] as const).map((d) => (
            <button type="button" class="fx-arrow" data-fx={d} aria-controls="fx-track"
              aria-label={d === 'prev' ? '이전 대표 포스트 글' : '다음 대표 포스트 글'}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={ARROW[d]} />
              </svg>
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="fx-track" id="fx-track" tabindex="0" aria-live="polite">
      {items.map((it, i) => (
        <article
          class:list={['fx-slide', i === 0 && 'is-on', !it.cover && 'blank-cover']}
          style={it.cover ? undefined : blankLight(it.slug)}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} / ${items.length} ${it.title}`}
        >
          {it.cover && (
            <>
              <img src={it.cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async"
                class="media-zoom absolute inset-0 -z-10 size-full object-cover" />
              <div class="media-scrim absolute inset-0 -z-10 bg-black/20"></div>
              <div class="media-scrim fx-scrim-bottom absolute inset-0 -z-10"></div>
              <div class="fx-scrim-hover -z-10"></div>
            </>
          )}

          {/* 덮개 링크는 글자 블록보다 아래에 깔린다. 사진 아무 데나 눌러도 글로 가면서 위의 링크를 가리지 않는다 */}

          <div class="relative">
            <p class="hero-type flex flex-wrap gap-x-3 text-sm font-semibold tracking-[.06em] text-white/80">
              {it.categories.map((c) => <span>{c}</span>)}
            </p>
            <h3 class="hero-type mt-3 text-2xl leading-snug font-bold text-white sm:text-3xl">
              <a href={`/${it.slug}/`} class="fx-title-link">{it.title}</a>
            </h3>
            <time datetime={it.date.toISOString().slice(0, 10)} class="hero-type mt-4 block text-sm text-white/75">
              {it.date.toISOString().slice(0, 10)}
            </time>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<script>
  /* NOTE 앞뒤에 칸을 하나씩 복제한다. 첫 칸과 끝 칸에서도 양옆에 실루엣이 남고,
   * 복제 칸에 멈추면 같은 그림의 진짜 칸으로 소리 없이 옮겨 끝이 없는 것처럼 보인다
   * - 위치는 스크롤이 진실이다. 인덱스를 따로 들면 손으로 민 뒤 버튼을 누를 때 어긋난다
   */
  const track = document.getElementById('fx-track');
  if (track) {
    const real = [...track.children] as HTMLElement[];
    const n = real.length;
    const at = document.querySelector('[data-fx-at]');
    const arrows = [...document.querySelectorAll<HTMLButtonElement>('[data-fx]')];
    const slow = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SETTLE_MS = 140; // 스크롤이 멎었다고 보는 시간
    const DRAG_PX = 8; // 이만큼 넘게 움직였으면 눌렀다가 아니라 끌었다고 본다

    /* 복제 칸은 같은 글이 두 번 읽히지 않게 접근성 트리에서 뺀다 */
    const clone = (el: HTMLElement) => {
      const c = el.cloneNode(true) as HTMLElement;
      c.dataset.clone = '';
      c.setAttribute('aria-hidden', 'true');
      for (const a of c.querySelectorAll('a')) a.setAttribute('tabindex', '-1');
      return c;
    };
    if (n > 1) {
      track.append(clone(real[0]));
      track.prepend(clone(real[n - 1]));
    }
    const all = [...track.children] as HTMLElement[];
    const first = n > 1 ? 1 : 0; // 복제 칸을 앞에 하나 두므로 진짜 첫 칸은 1번 자리다

    const step = () => {
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      return all[0].getBoundingClientRect().width + gap;
    };
    const slot = () => Math.round(track.scrollLeft / step());
    /* 자리를 옮기는 동안에는 전환을 꺼 번쩍임을 막는다 */
    const jump = (i: number) => {
      track.classList.add('is-jumping');
      track.scrollLeft = i * step();
      requestAnimationFrame(() => requestAnimationFrame(() => track.classList.remove('is-jumping')));
    };
    const go = (d: number) =>
      track.scrollTo({ left: (slot() + d) * step(), behavior: slow ? 'auto' : 'smooth' });

    for (const b of arrows) {
      b.addEventListener('click', () => go(b.dataset.fx === 'next' ? 1 : -1));
    }

    const normalize = () => {
      if (n < 2) return;
      const i = slot();
      if (i === 0) jump(n);
      else if (i === n + 1) jump(first);
    };

    let tick = 0;
    const sync = () => {
      cancelAnimationFrame(tick);
      tick = requestAnimationFrame(() => {
        const i = slot();
        all.forEach((s, k) => s.classList.toggle('is-on', k === i));
        const shown = n > 1 ? ((i - 1 + n) % n) + 1 : 1;
        if (at) at.textContent = String(shown);
      });
    };

    let settle: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      sync();
      clearTimeout(settle);
      settle = setTimeout(normalize, SETTLE_MS);
    }, { passive: true });
    addEventListener('resize', () => { jump(slot()); sync(); });

    /* 밀어서 넘기다 손을 뗐을 때 그 자리의 글이 열리는 사고를 막는다 */
    let down = 0;
    track.addEventListener('pointerdown', (e) => { down = (e as PointerEvent).clientX; }, { passive: true });
    track.addEventListener(
      'click',
      (e) => { if (Math.abs((e as PointerEvent).clientX - down) > DRAG_PX) { e.preventDefault(); e.stopPropagation(); } },
      true,
    );

    /* 진짜 첫 칸으로 옮긴다. 그리기 전에 옮겨야 자리가 튀지 않는다 */
    track.classList.add('is-jumping');
    track.scrollLeft = first * step();
    sync();
    requestAnimationFrame(() => {
      track.scrollLeft = first * step();
      sync();
      requestAnimationFrame(() => track.classList.remove('is-jumping'));
    });
  }
</script>
