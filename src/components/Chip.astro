---
/* 모양과 치수는 global.css 의 .chip 한 곳에 있다. 여기서 크기를 덧붙이지 않는다 */
interface Props {
  value: string;
  kind?: 'category' | 'tag';
  onDark?: boolean;
}
const { value, kind = 'category', onDark = false } = Astro.props;
---
<a
  href={`/category/#${encodeURIComponent(value)}`}
  class:list={['chip', kind === 'tag' && 'chip-tag', onDark && 'chip-on-dark']}
>{kind === 'tag' ? `#${value}` : value}</a>
