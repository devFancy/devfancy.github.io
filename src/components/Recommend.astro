---
/* NOTE 기존 Jekyll previousAndNext.html 의 Recommend 를 대체한다
 * - 태그 기반 Similar Posts 는 태그 데이터가 없어 렌더된 적이 없다. 이관하지 않는다 (4-6)
 * - 카테고리가 겹치는 최신 글을 최대 3개 보여주고, 없으면 섹션 자체를 그리지 않는다
 * - 섹션 제목만 본문 h2 크기다. 목록은 본문 글자 크기로 둬 위계를 지킨다
 * - "제목 위 / 날짜 아래" 배치는 PostCard 와 맞춘다 (4-3)
 */
import { getCollection } from 'astro:content';

interface Props {
  currentId: string;
  categories: string[];
}
const { currentId, categories } = Astro.props;
const mine = new Set(categories);

const related = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((p) => p.id !== currentId && p.data.categories.some((c) => mine.has(c)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
{related.length > 0 && (
  <section class="mt-16 border-t border-rule pt-8">
    {/* NOTE: 본문 h2 와 같은 크기·굵기라 글의 한 섹션처럼 이어진다 */}
    <h2 id="recommend" class="text-[25px] leading-snug font-medium">Recommend</h2>
    <ul class="mt-4">
      {related.map((p) => (
        <li class="border-b border-rule py-4 first:border-t">
          <a href={`/${p.id}/`} class="leading-snug hover:text-accent">{p.data.title}</a>
          <time datetime={p.data.date.toISOString().slice(0, 10)}
            class="mt-1.5 block text-sm text-muted">
            {p.data.date.toISOString().slice(0, 10)}
          </time>
        </li>
      ))}
    </ul>
  </section>
)}
