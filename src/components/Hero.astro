---
/* NOTE 배경 사진 위에 타이포만 얹는다. 페이지마다 같은 구조를 쓴다 [Hero 공통]
 * - 사진 밝기가 제각각이라 스크림으로 대비를 고정한다. dim 은 밝은 사진에서 올린다
 * - 헤더가 위에 떠 있어 상단을 한 겹 더 덮는다. 밝은 사진에서 메뉴가 묻혔다
 * - position 은 사진마다 다르다. 인물이 하단이면 bottom
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  title?: string;
  subtitle?: string;
  position?: 'center' | 'bottom' | 'top';
  align?: 'top' | 'bottom';
  dim?: 'normal' | 'strong';
  /* tall 은 사진을 더 넓게 보여준다. 세로로 긴 피사체가 잘릴 때 쓴다 */
  height?: 'normal' | 'tall';
}
const {
  image, title, subtitle,
  position = 'center', align = 'top', dim = 'normal', height = 'normal',
} = Astro.props;
---
<section
  class:list={[
    'relative isolate flex overflow-hidden',
    height === 'tall' ? 'min-h-[24rem] sm:min-h-[40rem]' : 'min-h-[20rem] sm:min-h-[32rem]',
    align === 'bottom' ? 'items-end' : 'items-start',
  ]}
>
  <Image
    src={image}
    alt=""
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class:list={[
      'hero-img absolute inset-0 -z-10 size-full object-cover',
      position === 'bottom' ? 'object-bottom' : position === 'top' ? 'object-top' : 'object-center',
    ]}
  />
  <div class:list={['hero-scrim absolute inset-0 -z-10', dim === 'strong' ? 'bg-black/60' : 'bg-black/45']}></div>
  <div class="hero-scrim absolute inset-x-0 top-0 -z-10 h-40 bg-gradient-to-b from-black/55 to-transparent"></div>
  {(title || subtitle) && (
    <div
      class:list={[
        'mx-auto w-full max-w-3xl px-4',
        align === 'bottom' ? 'pt-28 pb-24 sm:pb-28' : 'pt-28 pb-16 sm:pt-32',
      ]}
    >
      {title && (
        <h1 class="hero-type text-3xl font-semibold tracking-tight text-balance text-white sm:text-5xl">{title}</h1>
      )}
      {subtitle && <p class="hero-type mt-5 text-lg text-white/85 sm:text-xl">{subtitle}</p>}
    </div>
  )}
</section>
<div data-hero-end aria-hidden="true" class="h-px"></div>

<style>
  .hero-type { text-shadow: 0 1px 14px rgb(0 0 0 / .55); }

  /* 제목은 0ms 부터 떠 있다. 막이 옅은 동안은 글씨가 잘 안 읽혀 대기를 짧게 둔다 */
  .hero-scrim {
    animation: scrim-in 2.4s cubic-bezier(.33, 1, .68, 1) .2s both;
  }
  /* 줌은 훨씬 길게 끈다. 스크림과 같이 끝나면 "아직 로딩 중" 처럼 보인다 */
  .hero-img {
    animation: hero-settle 5s cubic-bezier(.33, 1, .68, 1) both;
  }

  @keyframes scrim-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes hero-settle {
    from { transform: scale(1.05); }
    to { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scrim,
    .hero-img { animation: none; }
  }
</style>
