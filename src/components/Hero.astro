---
/* NOTE 배경 사진 위에 타이포만 얹는다. 페이지마다 같은 구조를 쓴다 (4-3)
 * - src/assets 에 둬서 astro:assets 가 반응형 srcset 과 최신 포맷을 만든다 (4-7)
 * - 사진 밝기가 일정치 않으므로 스크림을 깔아 대비를 고정한다
 * - object-position 은 사진마다 다르다. 한강은 center, 파리는 인물이 하단이라 bottom
 * - align 은 문구 위치다. 인물 사진에서는 얼굴을 피하도록 페이지마다 정한다
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  title?: string;
  subtitle?: string;
  position?: 'center' | 'bottom' | 'top';
  align?: 'top' | 'bottom';
}
const { image, title, subtitle, position = 'center', align = 'top' } = Astro.props;
---
<section
  class:list={[
    'relative isolate flex min-h-[24rem] overflow-hidden sm:min-h-[32rem]',
    align === 'bottom' ? 'items-end' : 'items-start',
  ]}
>
  <Image
    src={image}
    alt=""
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class:list={[
      'absolute inset-0 -z-10 size-full object-cover',
      position === 'bottom' ? 'object-bottom' : position === 'top' ? 'object-top' : 'object-center',
    ]}
  />
  <div class="absolute inset-0 -z-10 bg-black/45"></div>
  {(title || subtitle) && (
    <div
      class:list={[
        'mx-auto w-full max-w-3xl px-4',
        align === 'bottom' ? 'pt-28 pb-12 sm:pb-16' : 'pt-28 pb-16 sm:pt-32',
      ]}
    >
      {title && (
        <h1 class="text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">{title}</h1>
      )}
      {subtitle && <p class="mt-3 text-base text-white/80 sm:text-lg">{subtitle}</p>}
    </div>
  )}
</section>
<div data-hero-end aria-hidden="true" class="h-px"></div>
