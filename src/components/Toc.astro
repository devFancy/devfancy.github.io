---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length >= 2 && (
  <nav aria-label="목차" class="text-[15px]">
    <p class="mb-3 text-sm font-semibold tracking-wide text-muted">목차</p>
    <ul class="space-y-1 border-l border-rule">
      {items.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            data-toc={h.slug}
            class:list={[
              '-ml-px block border-l-2 border-transparent py-1 leading-snug text-muted',
              'hover:border-rule hover:text-accent',
              h.depth === 2 ? 'pl-3' : 'pl-6',
            ]}
          >{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  /* 헤더(약 77px) 아래를 기준선으로 삼아 그 위로 지나간 마지막 제목 하나만 칠한다.
   * 교차 중인 제목을 모두 칠하면 목차 전체가 활성으로 보인다
   */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const heads = links.map((a) => document.getElementById(a.dataset.toc ?? ''));

  if (links.length) {
    const on = ['border-accent', 'text-accent'];
    let queued = false;

    const update = () => {
      queued = false;
      let idx = -1;
      for (let i = 0; i < heads.length; i++) {
        const h = heads[i];
        if (h && h.getBoundingClientRect().top <= 96) idx = i;
        else break;
      }
      links.forEach((a, i) => {
        for (const c of on) a.classList.toggle(c, i === idx);
      });
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    update();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
  }
</script>
