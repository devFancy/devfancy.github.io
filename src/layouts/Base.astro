---
import { GA_MEASUREMENT_ID, SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /* 섹션 페이지는 히어로에 이미 이름이 크게 떠 있어 탭 제목을 devfancy 하나로 고정한다 */
  title?: string;
  description?: string;
  useMath?: boolean;
  overHero?: boolean;
}
const { title, description = SITE.description, useMath = false, overHero = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161a" media="(prefers-color-scheme: dark)" />
    {/* NOTE: 통계는 배포본에서만 심는다. dev 방문이 집계에 섞이지 않게 */}
    {import.meta.env.PROD && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}

    {useMath && <link rel="stylesheet" href="/katex/katex.min.css" />}

    {/* NOTE: FOUC 방지. 렌더 전 동기 실행이라 인라인이어야 한다 [FOUC 방지] */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const dark = saved ? saved === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.dataset.theme = 'dark';
        } catch {}
      })();
    </script>
  </head>
  <body class="flex min-h-[100dvh] flex-col">
    <Header overlay={overHero} />
    <main class:list={['w-full flex-1', !overHero && 'pt-[4.6rem]']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
