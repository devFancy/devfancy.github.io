---
/* NOTE 없는 주소로 들어왔을 때 보여준다
 * - GitHub Pages 는 /404.html 을 자동으로 찾는다. 따로 설정할 것이 없다
 * - Jekyll 때는 없어서 깃허브 기본 화면이 떴다. 돌아갈 길을 만들어 둔다
 */
import Base from '../layouts/Base.astro';
import { NAV } from '../config';
---
<Base title="404" description="찾을 수 없는 페이지예요">
  <div class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-4 py-20">
    <p class="text-6xl font-bold text-quote">404</p>
    <h1 class="mt-4 text-3xl tracking-tight">찾을 수 없는 페이지예요</h1>
    <p class="mt-3 leading-relaxed text-muted">
      주소가 바뀌었거나 글이 지워졌을 수 있어요. 아래에서 다시 찾아보세요.
    </p>

    <ul class="mt-8 flex flex-wrap gap-3">
      <li>
        <a href="/" class="inline-block rounded-[3px] border border-rule px-4 py-2 text-muted
                           transition-colors hover:border-accent hover:text-accent">홈으로</a>
      </li>
      {NAV.map((n) => (
        <li>
          <a href={n.href} class="inline-block rounded-[3px] border border-rule px-4 py-2 text-muted
                                  transition-colors hover:border-accent hover:text-accent">{n.label}</a>
        </li>
      ))}
    </ul>
  </div>
</Base>
