---
import Base from '../layouts/Base.astro';
---
<Base title="404" description="찾을 수 없는 페이지예요">
  <div class="shell flex min-h-[60vh] flex-col justify-center py-20">
    <p class="text-6xl font-bold text-quote">404</p>
    <h1 class="mt-4 text-3xl tracking-tight">찾을 수 없는 페이지예요</h1>
    <a href="/" class="mt-8 inline-block self-start rounded-[3px] border border-rule px-4 py-2
                       text-muted transition-colors hover:border-accent hover:bg-accent hover:text-white">홈으로</a>
  </div>
</Base>
