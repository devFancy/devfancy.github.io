---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
// NOTE: Ponte Vecchio, Firenze. Unsplash License, 촬영 Giuseppe Mondi
import heroMain from '../assets/hero-main.jpg';
import Featured from '../components/Featured.astro';
import Hero from '../components/Hero.astro';
import PostTile from '../components/PostTile.astro';
import { coverOf } from '../lib/cover';
import { excerptOf } from '../lib/excerpt';
import { FEATURED, SITE, SOLUTION_CATEGORIES } from '../config';

const RECENT = 6;

const solution = new Set<string>(SOLUTION_CATEGORIES);
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/* config 에 적은 순서 그대로 보여준다. 슬러그가 틀리면 조용히 빠지지 않도록 빌드 로그에 남긴다 */
const byId = new Map(posts.map((p) => [p.id, p]));
const featured = FEATURED.flatMap((slug) => {
  const p = byId.get(slug);
  if (!p) {
    console.warn(`[대표 포스트 글] 슬러그를 찾지 못했습니다: ${slug}`);
    return [];
  }
  // NOTE: 사진이 없으면 기본 이미지 색 판으로 나간다. 그래서 빼지 않는다 [기본 이미지]
  return [{
    slug: p.id,
    title: p.data.title,
    date: p.data.date,
    categories: p.data.categories,
    cover: coverOf(p),
  }];
});

// NOTE: 문제풀이는 한 번에 여러 편이 올라가 최신 글을 독점한다. /solutions/ 로 뺀다 [문제풀이 분리]
const recent = posts
  .filter((p) => !p.data.categories.some((c) => solution.has(c)))
  .slice(0, RECENT);
---
<Base overHero>
  <Hero image={heroMain} title={SITE.hero.title} subtitle={SITE.hero.subtitle} align="bottom" />
  <div class="shell py-10">
    {featured.length > 0 && (
      <div class="mb-12 border-b border-rule pb-12">
        <Featured title="대표 포스트 글" note="부터 구경하실래요" items={featured} />
      </div>
    )}

    <section>
      <div class="fx-head">
        <h2 class="sec-head text-2xl">
          <span class="font-semibold">최신 포스트 글</span><span class="sec-note">은 요즘 쓰고 있는 것들이에요</span>
        </h2>
        <a href="/archive/" class="chip chip-lg shrink-0">전체 보기</a>
      </div>
      <div class="mt-7 flex flex-col gap-7">
        {recent.map((p) => (
          <PostTile slug={p.id} title={p.data.title} date={p.data.date}
            categories={p.data.categories} excerpt={p.data.summary ?? excerptOf(p.body ?? '')}
            cover={coverOf(p)} />
        ))}
      </div>
    </section>
  </div>
</Base>
