---
/* NOTE 홈은 대표 글과 최신 글만 보여준다. 목록 전체는 /archive/ 와 /category/ 가 맡는다 [홈 구성]
 * - 맨 위가 손으로 고른 대표 글, 그 아래가 최신 글 격자다 [대표 포스트 글]
 * - 최신 글은 카드 격자다. 모바일 1열, 그 위로 2열 [홈 격자]
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
// NOTE: Ponte Vecchio, Firenze. Unsplash License, 촬영 Giuseppe Mondi
import heroMain from '../assets/hero-main.jpg';
import Featured from '../components/Featured.astro';
import Hero from '../components/Hero.astro';
import PostTile from '../components/PostTile.astro';
import { coverOf } from '../lib/cover';
import { FEATURED, SITE, SOLUTION_CATEGORIES } from '../config';

// NOTE: 2열이라 짝수로 둔다. 홀수면 마지막 줄에 한 칸만 남는다 [홈 격자]
const RECENT = 6;

const solution = new Set<string>(SOLUTION_CATEGORIES);
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/* NOTE 대표 포스트 글은 config 에 적은 목록을 최신순으로 세워 보여준다 [대표 포스트 글]
 * - 슬러그가 틀리면 조용히 빠지지 않도록 빌드 로그에 남긴다
 */
const byId = new Map(posts.map((p) => [p.id, p]));
const featured = FEATURED.flatMap((slug) => {
  const p = byId.get(slug);
  if (!p) {
    console.warn(`[대표 포스트 글] 슬러그를 찾지 못했습니다: ${slug}`);
    return [];
  }
  // NOTE: 사진이 없으면 기본 이미지 색 판으로 나간다. 그래서 빼지 않는다 [기본 이미지]
  return [{
    slug: p.id,
    title: p.data.title,
    date: p.data.date,
    categories: p.data.categories,
    cover: coverOf(p),
  }];
}).sort((a, b) => b.date.getTime() - a.date.getTime());

// NOTE: 문제풀이는 한 번에 여러 편이 올라가 최신 글을 독점한다. /solutions/ 로 뺀다 [문제풀이 분리]
const recent = posts
  .filter((p) => !p.data.categories.some((c) => solution.has(c)))
  .slice(0, RECENT);
---
<Base overHero>
  <Hero image={heroMain} title={SITE.hero.title} subtitle={SITE.hero.subtitle} align="bottom" />
  <div class="shell py-10">
    {/* NOTE: 히어로 인사 다음에 오는 자리다. 한 문장과 그 아래 한 줄로 끝낸다 [홈 머리글] */}
    <section class="mb-12 border-b border-rule pb-10">
      <p class="max-w-2xl text-xl leading-relaxed text-balance sm:text-2xl">{SITE.intro}</p>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted">{SITE.introNote}</p>
    </section>

    {featured.length > 0 && (
      <section class="mb-14">
        <h2 class="text-2xl font-semibold">대표 포스트 글</h2>
        <div class="mt-5">
          <Featured items={featured} />
        </div>
      </section>
    )}

    <section>
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-semibold">최신 포스트 글</h2>
        <a href="/archive/" class="text-[15px] text-muted hover:text-accent">전체 보기 &rarr;</a>
      </div>
      <div class="mt-7 grid grid-cols-1 gap-x-6 gap-y-9 sm:grid-cols-2">
        {recent.map((p) => (
          <PostTile slug={p.id} title={p.data.title} date={p.data.date}
            categories={p.data.categories} cover={coverOf(p)} />
        ))}
      </div>
    </section>
  </div>
</Base>
