---
/* Jekyll /about/ 의 URL 을 그대로 유지한다 [URL 보존] */
import { Image } from 'astro:assets';
import heroAbout from '../assets/hero-about.jpg';
import profile from '../assets/profile.jpg';
import Hero from '../components/Hero.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { PROFILE } from '../config';
import Base from '../layouts/Base.astro';

const SUBTITLE = '저를 소개하자면..';

const WRITING = [
  {
    title: '나만의 글쓰기 파이프라인 구축하기',
    items: [
      '소재를 정하고 노션에 보관하면서 관련 소재를 깊이 있게 공부하자.',
      '초안을 작성할 때는 시간 제한과 방해금지 모드를 설정하자.',
      '업로드한 뒤에는 퇴고를 진행하면서 지속적으로 업데이트하자.',
    ],
  },
  {
    title: '이해하기 쉬우면서 읽기 편한 글을 작성하기',
    items: [
      '하나의 포스팅은 적절한 분량으로 작성한다.',
      '복잡한 내용은 그림 같은 시각 자료를 활용한다.',
      '무엇을 했는지보다 왜 그렇게 정했는지를 함께 적는다.',
    ],
  },
];

const DEV_HISTORY = [2026, 2025, 2024, 2023];

const WHO = [
  '어렸을 때부터 호기심이 많아 무언가를 기획하는 일을 좋아했습니다. 대학에서는 세 가지 전공을 거친 끝에, 생각한 것을 직접 만들어 볼 수 있는 컴퓨터학부를 선택했습니다. 먼 길을 돌아서 왔지만, 덕분에 삶의 지혜와 태도를 배웠습니다.',
  '사용자에게 즐거운 경험과 가치를 주는 서비스를 만드는 일에 관심이 있습니다. 문제를 정확히 정의하려고 노력하며 도메인을 먼저 이해한 뒤 기술로 풀 문제인지 가려냅니다. 필요한 구조를 설계하고 데이터로 가설을 검증하며, 실험을 통해 서비스를 개선합니다.',
  '휴식을 취할 때는 가끔 새로운 곳을 찾아 여행을 가거나 좋아하는 음악을 연주하면서 영감과 생기를 얻곤 합니다.',
];
---
<Base description={SUBTITLE} overHero>
  <Hero image={heroAbout} title="About" subtitle={SUBTITLE} align="bottom" height="tall" />

  <div class="shell py-14">
    <section>
      <h2 class="flex flex-wrap items-baseline gap-x-3 text-2xl font-bold">
        Who am I
        <span class="text-quote" aria-hidden="true">|</span>
        <span class="text-xl font-normal text-muted">{PROFILE.name}</span>
      </h2>

      {/* float 으로 감싸면 줄바꿈 지점이 화면 폭마다 달라져 통제가 안 된다 */}
      <div class="mt-7 flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
        <div class="flex shrink-0 flex-col items-center gap-4">
          {/* NOTE: densities 가 없으면 128px 한 장만 만들어 레티나에서 흐려진다 */}
          <Image
            src={profile}
            alt={PROFILE.name}
            width={128}
            height={128}
            densities={[1, 2]}
            loading="eager"
            class="size-32 rounded-full object-cover ring-1 ring-rule"
          />
          <SocialLinks size={22} />
        </div>

        <div class="min-w-0">
          {WHO.slice(0, 2).map((line) => (
            <p class="leading-relaxed text-body not-first:mt-4">{line}</p>
          ))}
        </div>
      </div>

      {WHO.slice(2).map((line) => (
        <p class="mt-6 leading-relaxed text-body">{line}</p>
      ))}
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-bold">Introduce</h2>
      <div class="prose mt-6">
        <p>제가 공부한 것 중에 기억하고 싶은 부분을 남기려고 이 블로그를 만들었습니다.</p>
        <p>개발자로 일하면서 느낀 점은 배워야 할 기술은 끝이 없고 끊임없이 변화하는 환경에 적응해야 한다는 것입니다. 그래서 남과 비교하기보다 제 속도를 지키며 지금 이 순간에 집중해 조금씩 나아가려 합니다.</p>
        <p>또한 기술만큼이나 태도 역시 중요하다고 생각합니다. 개발자는 혼자가 아니라 다양한 직군의 동료분들과 한 팀을 이뤄 공동의 목표를 향해 나아가는 사람입니다. 그래서 이곳에는 기술을 정리한 글뿐만 아니라 협업 과정에서 배운 점과 개발자로서의 태도도 함께 기록하려 합니다.</p>
        <p>이 블로그는 한 개발자의 성장 과정과 생각이 담긴 공간입니다. 화려한 글솜씨보다는 담백하고 솔직한 기록들이니 '이런 개발자도 있구나' 하는 마음으로 편하게 봐주시면 감사하겠습니다.</p>
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-bold">Technical Writing</h2>
      {/* NOTE: public 에 있는 파일이라 astro:assets 를 거치지 않는다. 거치면 빌드에 사본이 생긴다 */}
      <img
        src="/assets/img/retrospective/technical_writing/Technical-Writing-Seminar-Review-1.png"
        alt="글쓰기 파이프라인 세미나 정리"
        loading="lazy"
        class="mt-6 w-full rounded border border-rule"
      />
      {WRITING.map((block) => (
        <div class="mt-8">
          <p class="font-semibold text-fg/85">{block.title}</p>
          <ul class="mt-3 list-disc pl-5 text-body marker:text-quote">
            {block.items.map((item) => <li class="mt-2 leading-relaxed">{item}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-bold">Dev History</h2>
      <ul class="mt-6">
        {DEV_HISTORY.map((year) => (
          <li class="border-b border-rule first:border-t">
            <a href={`/${year}-DevHistory/`} class="link-title block py-3.5 text-body">
              {year} Dev History
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
